# --- TERRAFORM ---
# Archivos temporales --> inicialización
.terraform/

# Archivos de estado --> DATOS SENSIBLES
*.tfstate
*.tfstate.backup
*.tfstate.lock.info

# Variables personalizadas --> claves o IPs
*.tfvars
*.tfvars.json

# --- LAMBDAS / NODE ---
# Carpetas de dependencias --> NPM INSTALL
node_modules/
dist/

# Archivos de despliegue generados
*.zip

# Logs de error
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- SISTEMA / IDE ---
# Archivos de configuración de VS Code
.vscode/
.idea/

# Archivos temporales de Windows
Thumbs.db
ehthumbs.db
Desktop.ini
